# Webhook auth (long random secret; e.g. openssl rand -hex 32)
INGEST_TOKEN=

# Finwise
FINWISE_API_KEY=
FINWISE_BASE_URL=https://api.finwiseapp.io
# Default Bank Zero account (used when no filename pattern matches)
BANK_ZERO_ACCOUNT_ID=
# Optional: map filename substrings to account IDs (JSON array). First match wins. Example:
# BANK_ZERO_ACCOUNT_MAP=[{"pattern":"Savings","accountId":"finwise-savings-id"},{"pattern":"","accountId":"finwise-default-id"}]
# BANK_ZERO_ACCOUNT_MAP=

# Redis (e.g. Railway Redis URL)
REDIS_URL=

# Supabase (for DLQ and processed_transactions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3000
NODE_ENV=development
