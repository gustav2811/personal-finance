{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@investments/ingest-core": ["../../libs/ingest-core/src/index.ts"],
      "@investments/ingest-core/*": ["../../libs/ingest-core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
