# Copy to apps/ingest-cloudflare/.dev.vars (same folder as wrangler.*.toml).
# Wrangler reads .dev.vars from the current working directory when you run `yarn dev:*` from this app.
# Do not commit .dev.vars (repo root .gitignore ignores it).

# --- ingest worker (wrangler.ingest.toml) ---
INGEST_TOKEN=

# --- consumer worker (wrangler.consumer.toml) ---
FINWISE_API_KEY=
SUPABASE_SERVICE_KEY=
ISMRT_USERNAME=
ISMRT_PASSWORD=

# Optional for local consumer (override wrangler.consumer.toml [vars]):
# SUPABASE_URL=

# Optional fallback when no row in src/bank-zero-accounts.ts matches:
# BANK_ZERO_ACCOUNT_ID=
