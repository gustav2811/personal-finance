    "rules": [
      {
        "name": "The Data Accent Rule",
        "body": "Colour identifies a series or a state; labels and values must still explain it without colour.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Keep the interface and quantities in Geist; distinguish hierarchy with role, size, weight, spacing, and numeric features.",
