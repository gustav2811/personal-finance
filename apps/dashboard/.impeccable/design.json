      "description": "Rendered registry geometry translated to a portable preview; runtime behavior stays in shadcn.",
      "html": "<button type=\"button\" class=\"ds-button-destructive\">Destructive</button>",
      "css": ".ds-button-destructive{font-family:Geist,sans-serif;font-size:14px;line-height:20px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;cursor:pointer;background:color-mix(in oklab, var(--destructive, oklch(0.577 0.245 27.325)) 10%, transparent);color:var(--destructive, oklch(0.577 0.245 27.325));}.ds-button-destructive:hover{background:color-mix(in oklab, var(--destructive, oklch(0.577 0.245 27.325)) 20%, transparent);}.ds-button-destructive:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;}.ds-button-destructive:disabled{opacity:.5;pointer-events:none;}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled registry text field, with inline focus and invalid states.",
      "html": "<label class=\"ds-field\">Description<input class=\"ds-input\" placeholder=\"Merchant or description\" /></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:Geist,sans-serif;font-size:14px;line-height:20px;color:var(--foreground, oklch(0.145 0 0));}.ds-input{font-family:Geist,sans-serif;font-size:14px;line-height:20px;height:32px;padding:4px 10px;border:1px solid var(--input, oklch(0.922 0 0));border-radius:10px;background:transparent;color:var(--foreground, oklch(0.145 0 0));}.ds-input:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;}.ds-input::placeholder{color:var(--muted-foreground, oklch(0.556 0 0));}.ds-input:disabled{opacity:.5;}.ds-input[aria-invalid=true]{border-color:var(--destructive, oklch(0.577 0.245 27.325));}"
    },
    {
      "name": "Time-range choice",
      "kind": "chip",
      "refersTo": "range-choice",
      "description": "Connected single-selection choices. Runtime uses ToggleGroup keyboard behavior.",
      "html": "<div class=\"ds-choices\" role=\"group\" aria-label=\"Time range\"><button type=\"button\" aria-pressed=\"false\">30 days</button><button type=\"button\" aria-pressed=\"true\">90 days</button><button type=\"button\" aria-pressed=\"false\">1 year</button></div>",
      "css": ".ds-choices{display:flex;}.ds-choices button{font-family:Geist,sans-serif;font-size:14px;line-height:20px;font-size:12.8px;font-weight:500;height:28px;padding:0 8px;background:transparent;color:var(--foreground, oklch(0.145 0 0));border:1px solid var(--border, oklch(0.922 0 0));cursor:pointer;}.ds-choices button+button{margin-left:-1px;}.ds-choices button:first-child{border-radius:10px 0 0 10px;}.ds-choices button:last-child{border-radius:0 10px 10px 0;}.ds-choices button[aria-pressed=true],.ds-choices button:hover{background:var(--muted, oklch(0.97 0 0));}.ds-choices button:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;position:relative;z-index:1;}"
    },
    {
      "name": "Fact group",
      "kind": "card",
      "refersTo": "fact-grid",
      "description": "Read-only labelled values. Illustrative amounts; not a generic dashboard card.",
      "html": "<dl class=\"ds-facts\"><div><dt>Usage</dt><dd>235.4 kWh<small>Closed days only</small></dd></div><div><dt>Cost</dt><dd>R780<small>Incurred charges</small></dd></div></dl>",
      "css": ".ds-facts{font-family:Geist,sans-serif;font-size:14px;line-height:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1px;margin:0;overflow:hidden;border:1px solid var(--border, oklch(0.922 0 0));border-radius:10px;background:var(--border, oklch(0.922 0 0));color:var(--foreground, oklch(0.145 0 0));}.ds-facts>div{padding:12px 16px;background:var(--card, oklch(1 0 0));}.ds-facts dt{font-size:12px;font-weight:500;line-height:1.3;color:var(--muted-foreground, oklch(0.556 0 0));}.ds-facts dd{margin:4px 0 0;font-size:24px;font-weight:600;letter-spacing:-.025em;font-variant-numeric:tabular-nums;}.ds-facts small{display:block;font-size:12px;font-weight:400;line-height:1.4;letter-spacing:normal;color:var(--muted-foreground, oklch(0.556 0 0));}"
    },
    {
      "name": "Custom chart tooltip",
      "kind": "custom",
      "refersTo": "chart-tooltip",
      "description": "Domain-specific readout in the shared tooltip surface; illustrative values.",
      "html": "<div class=\"ds-chart-tip\"><strong>14 Oct</strong><div>Usage: 16.8 kWh</div><div>Cost: R56</div></div>",
      "css": ".ds-chart-tip{font-family:Geist,sans-serif;font-size:14px;line-height:20px;display:grid;gap:4px;width:fit-content;padding:6px 10px;border:1px solid var(--border, oklch(0.922 0 0));border-radius:10px;background:var(--background, oklch(1 0 0));color:var(--foreground, oklch(0.145 0 0));font-size:12px;line-height:16px;font-variant-numeric:tabular-nums;box-shadow:0 20px 25px -5px rgb(0 0 0 / .1),0 8px 10px -6px rgb(0 0 0 / .1);}"
    },
    {
      "name": "Sidebar destination",
      "kind": "nav",
      "refersTo": "sidebar-item",
