  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Rendered registry geometry translated to a portable preview; runtime behavior stays in shadcn.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Primary</button>",
      "css": ".ds-button-primary{font-family:Geist,sans-serif;font-size:14px;line-height:20px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;cursor:pointer;background:var(--primary, oklch(0.205 0 0));color:var(--primary-foreground, oklch(0.985 0 0));}.ds-button-primary:hover{background:color-mix(in oklab, var(--primary, oklch(0.205 0 0)) 90%, transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;}.ds-button-primary:disabled{opacity:.5;pointer-events:none;}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Rendered registry geometry translated to a portable preview; runtime behavior stays in shadcn.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Secondary</button>",
      "css": ".ds-button-secondary{font-family:Geist,sans-serif;font-size:14px;line-height:20px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;cursor:pointer;background:var(--secondary, oklch(0.97 0 0));color:var(--secondary-foreground, oklch(0.205 0 0));}.ds-button-secondary:hover{background:color-mix(in oklab, var(--secondary, oklch(0.97 0 0)) 90%, transparent);}.ds-button-secondary:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;}.ds-button-secondary:disabled{opacity:.5;pointer-events:none;}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Rendered registry geometry translated to a portable preview; runtime behavior stays in shadcn.",
      "html": "<button type=\"button\" class=\"ds-button-outline\">Outline</button>",
      "css": ".ds-button-outline{font-family:Geist,sans-serif;font-size:14px;line-height:20px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;cursor:pointer;background:var(--background, oklch(1 0 0));color:var(--foreground, oklch(0.145 0 0));border-color:var(--border, oklch(0.922 0 0));}.ds-button-outline:hover{background:var(--accent, oklch(0.97 0 0));color:var(--accent-foreground, oklch(0.205 0 0));}.ds-button-outline:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;}.ds-button-outline:disabled{opacity:.5;pointer-events:none;}"
    },
    {
