      "css": ".ds-button-ghost{font-family:Geist,sans-serif;font-size:14px;line-height:20px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;cursor:pointer;background:transparent;color:var(--foreground, oklch(0.145 0 0));}.ds-button-ghost:hover{background:var(--accent, oklch(0.97 0 0));color:var(--accent-foreground, oklch(0.205 0 0));}.ds-button-ghost:focus-visible{outline:2px solid var(--ring, oklch(0.708 0 0));outline-offset:2px;}.ds-button-ghost:disabled{opacity:.5;pointer-events:none;}"
